# Dependencies
node_modules/
archived/**/node_modules/

# Local env and secrets (never commit)
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Editor / IDE (prefer user-local settings)
.idea/
.vscode/
*.swp
*.swo
*~

# Caches / build tooling
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
.npm/
.yarn/
.pnp.*

# Logs / coverage / temp
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/
.nyc_output/
tmp/
temp/
*.tmp

# dist/ policy:
# Studio's dist/ is a build output. CI builds it (deploy-pages.yml runs
# npm run build:site → npm run build --prefix apps/studio) and deploys the
# generated site/ artifact, so it is no longer committed. For local serving
# (Live Server etc.) run: npm run build --prefix apps/studio
apps/studio/dist/

# Studio's archived/ (old v1/v2 trees) is local reference only; it is excluded
# from build:site and never served. It stays in git history.
apps/studio/archived/

# Local API keys (copy from config.keys.local.example.js)
apps/studio/src/js/config.keys.local.js
src/js/config.keys.local.js

# Generated publish tree (npm run build:site)
site/
