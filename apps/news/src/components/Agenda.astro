---
import type { AgendaItem } from '../data/types';
interface Props {
  items: AgendaItem[];
}
const { items } = Astro.props;
---
<section class="agenda" aria-label="Today's agenda" data-live-agenda>
  <h2 class="section-label">Today's Agenda</h2>
  <ul class="agenda-list">
    {items.map((item) => (
      <li>
        <span class="time">{item.time}</span>
        <span class="title">{item.title}</span>
        {item.note && <span class="note">{item.note}</span>}
      </li>
    ))}
  </ul>
</section>
