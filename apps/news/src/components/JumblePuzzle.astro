---
import type { JumbleEntry } from '../data/types';
interface Props {
  puzzle: JumbleEntry;
  /** Section heading — default "Jumble 1" */
  heading?: string;
}
const { puzzle, heading = 'Jumble 1' } = Astro.props;
const scrambledLetters = puzzle.scrambled.replace(/\s+/g, '').toUpperCase().split('');
const answerLen = puzzle.answer.replace(/\s+/g, '').length;
const answerBlanks = Array.from({ length: answerLen }, (_, i) => i);
const hintText = puzzle.clue.toLowerCase().startsWith('hint:') ? puzzle.clue : `Hint: ${puzzle.clue}`;
---
<section class="jumble-box" aria-label={heading}>
  <h2 class="section-label">{heading}</h2>

  <div class="jumble-word-block">
    <div class="jumble-tiles" aria-label={`Scrambled: ${puzzle.scrambled}`}>
      {scrambledLetters.map((ch) => (
        <span class="jumble-tile">{ch}</span>
      ))}
    </div>
    <div class="jumble-blanks" aria-label={`${answerLen}-letter answer blanks`}>
      {answerBlanks.map(() => <span class="jumble-blank" />)}
    </div>
  </div>

  <p class="jumble-clue" title="Upside-down hint">{hintText}</p>
</section>
