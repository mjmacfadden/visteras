      function attachRichTextPasteHandler(el: HTMLTextAreaElement | null) {
        if (!el) return;
        el.addEventListener('paste', (e: ClipboardEvent) => {
          const clipboardData = e.clipboardData;
          if (!clipboardData) return;

          const html = clipboardData.getData('text/html');
          if (!html || !html.trim()) return;

          const markdown = htmlToMarkdown(html);
          if (!markdown || !markdown.trim()) return;

          // Check if HTML actually contained rich elements or images
          const plainText = clipboardData.getData('text/plain') || '';
          const hasRichContent =
            /<(?:img|h[1-6]|strong|b|em|i|a|ul|ol|li|blockquote|figure)\b/i.test(html);
          if (!hasRichContent && plainText.trim()) {
            return; // Allow native plain text paste if no rich elements were present
          }

          e.preventDefault();
          const start = el.selectionStart ?? 0;
          const end = el.selectionEnd ?? 0;
          const currentVal = el.value;
          const nextVal = currentVal.substring(0, start) + markdown + currentVal.substring(end);
          el.value = nextVal;
          el.selectionStart = el.selectionEnd = start + markdown.length;
          el.dispatchEvent(new Event('input', { bubbles: true }));
        });
      }

      attachRichTextPasteHandler(document.getElementById('grok-paste-quick') as HTMLTextAreaElement | null);
      attachRichTextPasteHandler(document.getElementById('grok-brief-input') as HTMLTextAreaElement | null);

      function shortComicUrl(href: string) {
        return href.replace(/^https?:\/\//i, '').replace(/^www\./i, '');
      }

      function fitComicSourceUrls(root: ParentNode = document) {
        root.querySelectorAll<HTMLElement>('.comic-source-url[data-fit-url]').forEach((el) => {
          const parent = el.parentElement;
          if (!parent) return;
          el.style.fontSize = '';
          let size = 0.52; // rem
          el.style.fontSize = `${size}rem`;
          // Shrink until it fits one line in the comic column
          for (let i = 0; i < 24 && el.scrollWidth > parent.clientWidth && size > 0.32; i++) {
            size -= 0.02;
            el.style.fontSize = `${size}rem`;
          }
        });
      }

      function escapeAttr(t: string) {
        return escapeHtml(t).replace(/`/g, '&#96;');
      }

      const NY_GENERIC_BLURB = 'A drawing that riffs on the latest news and happenings.';

      function isNewYorkerFeedIdClient(feedId: string | undefined | null): boolean {
        if (!feedId) return false;
        return feedId === 'newyorker-daily' || feedId.startsWith('newyorker');
      }

      function shouldShowNyCaption(c: {
        feedId?: string;
        id: string;
        title: string;
        caption: string;
        imageUrl?: string | null;
      }): boolean {
        const feedId = c.feedId || c.id.split('-')[0] || c.id;
        const cap = (c.caption || '').trim();
        if (!c.imageUrl || !isNewYorkerFeedIdClient(feedId) || !cap) return false;
        if (cap === NY_GENERIC_BLURB) return false;
        if (cap === (c.title || '').trim()) return false;
        return true;
      }

      function comicBoxHtml(
        c: {
          id: string;
          feedId?: string;
          title: string;
          credit: string;
          caption: string;
          imageUrl?: string | null;
          link?: string;
          live?: boolean;
        },
        slotIndex = 0,
      ) {
        const href = c.link || c.imageUrl || '';
        const feedId = c.feedId || c.id.split('-')[0] || c.id;
        const img = c.imageUrl
          ? `<a class="comic-image-link" href="${escapeAttr(href)}" target="_blank" rel="noopener noreferrer">
              <img class="comic-image" src="${escapeAttr(c.imageUrl)}" alt="${escapeAttr(c.title)} — ${escapeAttr(c.caption)}" loading="lazy" referrerpolicy="no-referrer" data-comic-img />
            </a>`
          : `<p class="comic-caption-only">${escapeHtml(c.caption)}</p>`;
        const nyCaption = shouldShowNyCaption(c)
          ? `<p class="comic-caption">${escapeHtml(c.caption)}</p>`
          : '';
        const source = href
          ? `<p class="comic-source"><a class="comic-source-url" href="${escapeAttr(href)}" target="_blank" rel="noopener noreferrer" data-fit-url>${escapeHtml(shortComicUrl(href))}</a></p>`
          : '';
        return `<section class="comic-box" aria-label="${escapeAttr(c.title)}" data-comic-id="${escapeAttr(c.id)}" data-comic-feed-id="${escapeAttr(feedId)}" data-comic-slot="${slotIndex}" data-comic-live="${c.live ? '1' : '0'}">
          <h2 class="section-label">${escapeHtml(c.title)}</h2>
          <div class="comic-frame">
            <div class="comic-credit">${escapeHtml(c.credit)}${c.live === false ? ' <span class="comic-fallback-flag"> · feed fallback</span>' : ''}</div>
            ${img}
            ${nyCaption}
            ${source}
            <div class="comic-cycle-controls" role="toolbar" aria-label="Change comic strip">
              <button type="button" class="comic-cycle-btn" data-comic-cycle="prev" title="Previous comic strip" aria-label="Previous comic strip">◂ Prev</button>
              <button type="button" class="comic-cycle-btn" data-comic-cycle="next" title="Next comic strip" aria-label="Next comic strip">Next ▸</button>
            </div>
          </div>
        </section>`;
      }

      let comicsPool: {
        id: string;
        feedId?: string;
        title: string;
        credit: string;
        caption: string;
        imageUrl?: string | null;
        link?: string;
        live?: boolean;
      }[] = [];
      try {
        const poolEl = document.getElementById('comics-pool');
        if (poolEl?.textContent) comicsPool = JSON.parse(poolEl.textContent);
      } catch {
        comicsPool = [];
      }

      const failedComicIds = new Set<string>();

      function getSlotIndex(box: HTMLElement): number {
        const raw = box.dataset.comicSlot;
        if (raw != null && raw !== '') return Number(raw);
        const parent = box.parentElement;
        if (!parent) return 0;
        const idx = Array.from(parent.children).indexOf(box);
        return idx >= 0 ? idx : 0;
      }

      function getOtherSlotComicId(slotIndex: number): string | null {
        const otherSlot = slotIndex === 0 ? 1 : 0;
        const otherBox = document.querySelector<HTMLElement>(
          `.edition-document [data-live-comics] .comic-box[data-comic-slot="${otherSlot}"]`,
        ) || document.querySelector<HTMLElement>(
          `#paged-edition [data-live-comics] .comic-box[data-comic-slot="${otherSlot}"]`,
        );
        return otherBox?.dataset.comicId || null;
      }

      function getCandidateComics(slotIndex: number, s: PaperSettings = settings) {
        const enabled = new Set(s.enabledComicIds);
        const otherId = getOtherSlotComicId(slotIndex);
        return comicsPool.filter((c) => {
          if (!c.imageUrl || failedComicIds.has(c.id)) return false;
          const feedId = c.feedId || c.id.split('-')[0];
          if (enabled.size > 0 && !enabled.has(feedId)) return false;
          if (otherId && c.id === otherId) return false;
          return true;
        });
      }

      function updateComicBoxDom(box: HTMLElement, c: typeof comicsPool[0]) {
        box.dataset.comicId = c.id;
        box.dataset.comicFeedId = c.feedId || c.id.split('-')[0];
        box.dataset.comicLive = c.live ? '1' : '0';

        const label = box.querySelector('.section-label');
        if (label) label.textContent = c.title;

        const credit = box.querySelector('.comic-credit');
        if (credit) {
          credit.innerHTML = `${escapeHtml(c.credit)}${c.live === false ? ' <span class="comic-fallback-flag"> · feed fallback</span>' : ''}`;
        }

        const href = c.link || c.imageUrl || '';
        const link = box.querySelector<HTMLAnchorElement>('.comic-image-link');
        const img = box.querySelector<HTMLImageElement>('.comic-image');
        if (img && c.imageUrl) {
          img.src = c.imageUrl;
          img.alt = `${c.title} — ${c.caption}`;
        }
        if (link) {
          link.href = href || '#';
        }

        let captionEl = box.querySelector<HTMLParagraphElement>('.comic-caption');
        if (shouldShowNyCaption(c)) {
          if (!captionEl) {
            captionEl = document.createElement('p');
            captionEl.className = 'comic-caption';
            const source = box.querySelector('.comic-source');
            const frame = box.querySelector('.comic-frame');
            if (source) {
              source.before(captionEl);
            } else if (frame) {
              const controls = frame.querySelector('.comic-cycle-controls');
              if (controls) controls.before(captionEl);
              else frame.appendChild(captionEl);
            }
          }
          captionEl.textContent = c.caption;
        } else if (captionEl) {
          captionEl.remove();
        }

        const srcUrl = box.querySelector<HTMLAnchorElement>('.comic-source-url');
        if (srcUrl) {
          srcUrl.href = href;
          srcUrl.textContent = shortComicUrl(href);
        }
        fitComicSourceUrls(box);
      }

      function updateComicSlot(slotIndex: number, c: typeof comicsPool[0]) {
        document
          .querySelectorAll<HTMLElement>(`[data-live-comics] .comic-box[data-comic-slot="${slotIndex}"]`)
          .forEach((box) => {
            updateComicBoxDom(box, c);
          });
      }

      function cycleComicSlot(box: HTMLElement, direction: 'next' | 'prev' = 'next') {
        const slotIndex = getSlotIndex(box);
        const candidates = getCandidateComics(slotIndex);
        if (candidates.length <= 1) return;
        const currentId = box.dataset.comicId || '';
        const curIdx = candidates.findIndex((c) => c.id === currentId);
        let nextIdx = 0;
        if (direction === 'next') {
          nextIdx = curIdx >= 0 ? (curIdx + 1) % candidates.length : 0;
        } else {
          nextIdx = curIdx >= 0 ? (curIdx - 1 + candidates.length) % candidates.length : candidates.length - 1;
        }
        const nextComic = candidates[nextIdx];
        if (nextComic) {
          updateComicSlot(slotIndex, nextComic);
          schedulePaginate();
        }
      }

      function applyComicVisibility(s: PaperSettings) {
        const enabled = new Set(s.enabledComicIds);
        const activeIds = new Set<string>();

        [0, 1].forEach((slotIndex) => {
          const boxes = document.querySelectorAll<HTMLElement>(
            `[data-live-comics] .comic-box[data-comic-slot="${slotIndex}"]`,
          );
          const firstBox = boxes[0];
          if (!firstBox) return;

          let feedId = firstBox.dataset.comicFeedId || firstBox.dataset.comicId?.split('-')[0] || '';
          let currentId = firstBox.dataset.comicId || '';

          if (!enabled.has(feedId) || failedComicIds.has(currentId) || activeIds.has(currentId)) {
            const candidate = comicsPool.find((c) => {
              if (!c.imageUrl || failedComicIds.has(c.id) || activeIds.has(c.id)) return false;
              const fId = c.feedId || c.id.split('-')[0];
              return enabled.has(fId);
            });
            if (candidate) {
              updateComicSlot(slotIndex, candidate);
              feedId = candidate.feedId || candidate.id.split('-')[0];
              currentId = candidate.id;
            }
          }

          const want = Boolean(feedId && enabled.has(feedId) && !activeIds.has(currentId));
          boxes.forEach((b) => {
            b.style.display = want ? '' : 'none';
          });
          if (want && currentId) {
            activeIds.add(currentId);
          }
        });
        fitComicSourceUrls();
        schedulePaginate();
      }

      document.addEventListener(
        'error',
        (e) => {
          const img = e.target as HTMLElement | null;
          if (!img || img.tagName !== 'IMG' || !img.hasAttribute('data-comic-img')) return;
          const box = img.closest('.comic-box') as HTMLElement | null;
          if (!box) return;
          const failedId = box.dataset.comicId || '';
          if (failedId) {
            if (failedComicIds.has(failedId)) return;
            failedComicIds.add(failedId);
          }
          cycleComicSlot(box, 'next');
          applyComicVisibility(settings);
          schedulePaginate();
        },
        true,
      );

      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement | null;
        const customCycleBtn = t?.closest?.('[data-custom-feed-cycle]') as HTMLElement | null;
        if (customCycleBtn) {
          e.preventDefault();
          e.stopPropagation();
          const feedId = customCycleBtn.getAttribute('data-feed-id') || '';
          const dir = customCycleBtn.getAttribute('data-custom-feed-cycle');
          const stories = customFeedPools[feedId] || [];
          if (stories.length > 1) {
            let cur = customFeedIndices[feedId] ?? 0;
            cur = dir === 'next' ? (cur + 1) % stories.length : (cur - 1 + stories.length) % stories.length;
            customFeedIndices[feedId] = cur;
            renderCustomFeeds();
            schedulePaginate();
          }
          return;
        }

        const cycleBtn = t?.closest?.('[data-comic-cycle]') as HTMLElement | null;
        if (cycleBtn) {
          e.preventDefault();
          e.stopPropagation();
          const box = cycleBtn.closest('.comic-box') as HTMLElement | null;
          const dir = cycleBtn.getAttribute('data-comic-cycle') === 'prev' ? 'prev' : 'next';
          if (box) cycleComicSlot(box, dir);
          return;
        }

        // Lead story Add Image button (hover over title)
        const addBtn = t?.closest?.('[data-lead-image-add]') as HTMLElement | null;
        if (addBtn) {
          e.preventDefault();
          e.stopPropagation();
          document.querySelectorAll<HTMLElement>('.lead-story').forEach((story) => {
            const frame = story.querySelector<HTMLElement>('.lead-image-frame');
            if (frame) {
              frame.classList.remove('is-hidden');
              frame.classList.add('is-editing');
            }
          });
          schedulePaginate();
          window.setTimeout(() => {
            const input = document.querySelector<HTMLInputElement>(
              '#paged-edition [data-lead-image-input], .lead-image-url-input',
            );
            if (input) {
              input.focus();
              input.select();
            }
          }, 80);
          return;
        }

        // Lead image Change Image button
        const changeBtn = t?.closest?.('[data-lead-image-change]') as HTMLElement | null;
        if (changeBtn) {
          e.preventDefault();
          e.stopPropagation();
          document.querySelectorAll<HTMLElement>('.lead-image-frame').forEach((frame) => {
            frame.classList.remove('is-hidden');
            frame.classList.add('is-editing');
          });
          schedulePaginate();
          window.setTimeout(() => {
            const input = document.querySelector<HTMLInputElement>(
              '#paged-edition [data-lead-image-input], .lead-image-url-input',
            );
            if (input) {
              input.focus();
              input.select();
            }
          }, 80);
          return;
        }

        // Lead image Cancel URL button
        const cancelBtn = t?.closest?.('[data-lead-image-cancel]') as HTMLElement | null;
        if (cancelBtn) {
          e.preventDefault();
          e.stopPropagation();
          document.querySelectorAll<HTMLElement>('.lead-story').forEach((story) => {
            const frame = story.querySelector<HTMLElement>('.lead-image-frame');
            const img = frame?.querySelector<HTMLImageElement>('.story-image');
            const customUrl = loadLeadCustomUrl();
            const orig = img?.getAttribute('data-original-src');
            const currentSrc = customUrl || orig || img?.src || '';
            frame?.classList.remove('is-editing', 'is-failed');
            if (!currentSrc) {
              frame?.classList.add('is-hidden');
              story.classList.add('no-image');
              story.classList.remove('has-image');
            } else {
              frame?.classList.remove('is-hidden');
              story.classList.add('has-image');
              story.classList.remove('no-image');
            }
          });
          schedulePaginate();
          return;
        }

        // Lead image Delete / Remove button
        const deleteBtn = t?.closest?.('[data-lead-image-delete]') as HTMLElement | null;
        if (deleteBtn) {
          e.preventDefault();
          e.stopPropagation();
          try {
            localStorage.setItem(LEAD_CUSTOM_URL_KEY, '__none__');
          } catch {}
          document.querySelectorAll<HTMLElement>('.lead-story').forEach((story) => {
            story.classList.remove('has-image', 'lead-image-failed');
            story.classList.add('no-image');
            const frame = story.querySelector<HTMLElement>('.lead-image-frame');
            if (frame) {
              frame.classList.remove('is-editing', 'is-failed');
              frame.classList.add('is-hidden');
              const img = frame.querySelector<HTMLImageElement>('.story-image');
              if (img) img.src = '';
            }
          });
          schedulePaginate();
          return;
        }

        // Lead image Reset URL button
        const resetBtn = t?.closest?.('[data-lead-image-reset]') as HTMLElement | null;
        if (resetBtn) {
          e.preventDefault();
          e.stopPropagation();
          try {
            localStorage.removeItem(LEAD_CUSTOM_URL_KEY);
          } catch {}
          document.querySelectorAll<HTMLElement>('.lead-story').forEach((story) => {
            const frame = story.querySelector<HTMLElement>('.lead-image-frame');
            const img = frame?.querySelector<HTMLImageElement>('.story-image');
            const orig = img?.getAttribute('data-original-src');
            frame?.classList.remove('is-editing', 'is-failed');
            if (orig) {
              story.classList.remove('no-image', 'lead-image-failed');
              story.classList.add('has-image');
              frame?.classList.remove('is-hidden');
              if (img) img.src = orig;
            } else {
              story.classList.remove('has-image', 'lead-image-failed');
              story.classList.add('no-image');
              frame?.classList.add('is-hidden');
            }
          });
          schedulePaginate();
          return;
        }

        // Lead image Save / Apply URL button
        const saveBtn = t?.closest?.('[data-lead-image-save]') as HTMLElement | null;
        if (saveBtn) {
          e.preventDefault();
          e.stopPropagation();
          const frame = saveBtn.closest<HTMLElement>('.lead-image-frame');
          const input = frame?.querySelector<HTMLInputElement>('[data-lead-image-input]');
          const newUrl = input?.value.trim();
          if (newUrl) {
            try {
              localStorage.setItem(LEAD_CUSTOM_URL_KEY, newUrl);
            } catch {}
            document.querySelectorAll<HTMLElement>('.lead-story').forEach((story) => {
              story.classList.remove('no-image', 'lead-image-failed');
              story.classList.add('has-image');
              const f = story.querySelector<HTMLElement>('.lead-image-frame');
              if (f) {
                f.classList.remove('is-editing', 'is-failed', 'is-hidden');
                const img = f.querySelector<HTMLImageElement>('.story-image');
                if (img) img.src = newUrl;
              }
            });
            schedulePaginate();
          }
          return;
        }
      });

      // Keep input values in sync across document versions (#edition-document vs #paged-edition)
      document.addEventListener('input', (e) => {
        const input = e.target as HTMLInputElement | null;
        if (!input || !input.matches('[data-lead-image-input]')) return;
        const val = input.value;
        document.querySelectorAll<HTMLInputElement>('[data-lead-image-input]').forEach((el) => {
          if (el !== input) {
            el.value = val;
          }
        });
      });

      // Listen for image load errors on lead images
      document.addEventListener(
        'error',
        (e) => {
          const t = e.target as HTMLElement | null;
          if (!t || t.tagName !== 'IMG') return;
          if (t.matches('[data-lead-image]') || t.closest('.lead-image-frame')) {
            const firstFrame = document.querySelector<HTMLElement>('.lead-image-frame');
            if (firstFrame && firstFrame.classList.contains('is-failed')) return;
            document.querySelectorAll<HTMLElement>('.lead-story').forEach((story) => {
              story.classList.remove('has-image');
              story.classList.add('no-image', 'lead-image-failed');
            });
            document.querySelectorAll<HTMLElement>('.lead-image-frame').forEach((frame) => {
              frame.classList.add('is-failed');
              if (!frame.classList.contains('is-editing')) {
                frame.classList.add('is-hidden');
              }
            });
            schedulePaginate();
          }
        },
        true,
      );

      // Listen for image load success on lead images
      document.addEventListener(
        'load',
        (e) => {
          const t = e.target as HTMLElement | null;
          if (!t || t.tagName !== 'IMG') return;
          if (t.matches('[data-lead-image]') || t.closest('.lead-image-frame')) {
            const firstFrame = document.querySelector<HTMLElement>('.lead-image-frame');
            if (firstFrame && firstFrame.classList.contains('is-failed')) {
              document.querySelectorAll<HTMLElement>('.lead-story').forEach((story) => {
                story.classList.remove('lead-image-failed', 'no-image');
                story.classList.add('has-image');
              });
              document.querySelectorAll<HTMLElement>('.lead-image-frame').forEach((frame) => {
                frame.classList.remove('is-failed');
                if (!frame.classList.contains('is-editing')) {
                  frame.classList.remove('is-hidden');
                }
              });
              schedulePaginate();
            }
          }
        },
        true,
      );

      // Drag-to-reposition lead image
      let isDraggingLead = false;
      let startPointerY = 0;
      let startPosY = 50;
      let activeFrame: HTMLElement | null = null;

      document.addEventListener('pointerdown', (e) => {
        const t = e.target as HTMLElement | null;
        if (!t || !t.matches('.lead-image-frame .story-image')) return;
        if (t.closest('[data-lead-placeholder-box]') || t.closest('.lead-image-controls')) return;
        e.preventDefault();
        const frame = t.closest<HTMLElement>('.lead-image-frame');
        if (!frame) return;

        isDraggingLead = true;
        startPointerY = e.clientY;
        startPosY = loadLeadImagePosY();
        activeFrame = frame;
        frame.classList.add('is-dragging');
        (t as HTMLElement).setPointerCapture?.(e.pointerId);
      });

      document.addEventListener('pointermove', (e) => {
        if (!isDraggingLead || !activeFrame) return;
        const frameHeight = activeFrame.clientHeight || 220;
        const dy = e.clientY - startPointerY;
        const deltaPercent = (dy / frameHeight) * 100;
        const newPosY = Math.max(0, Math.min(100, Math.round(startPosY - deltaPercent)));

        document.querySelectorAll<HTMLImageElement>('.lead-image-frame .story-image').forEach((img) => {
          img.style.objectPosition = `center ${newPosY}%`;
        });
      });

      function endLeadDrag() {
        if (!isDraggingLead) return;
        isDraggingLead = false;
        if (activeFrame) {
          activeFrame.classList.remove('is-dragging');
          const img = activeFrame.querySelector<HTMLImageElement>('.story-image');
          if (img) {
            const match = img.style.objectPosition.match(/center\s+(\d+(?:\.\d+)?)%/);
            const val = match ? parseFloat(match[1]) : 50;
            const valid = isNaN(val) ? 50 : Math.max(0, Math.min(100, val));
            try {
              localStorage.setItem(LEAD_POS_Y_KEY, String(valid));
            } catch {}
          }
        }
        activeFrame = null;
      }

      document.addEventListener('pointerup', endLeadDrag);
      document.addEventListener('pointercancel', endLeadDrag);

      document.addEventListener('keydown', (e) => {
        const input = e.target as HTMLElement | null;
        if (!input || !input.matches('[data-lead-image-input]')) return;
        if (e.key === 'Enter') {
          e.preventDefault();
          const frame = input.closest<HTMLElement>('.lead-image-frame');
          frame?.querySelector<HTMLElement>('[data-lead-image-save]')?.click();
        } else if (e.key === 'Escape') {
          e.preventDefault();
          const frame = input.closest<HTMLElement>('.lead-image-frame');
          frame?.querySelector<HTMLElement>('[data-lead-image-cancel]')?.click();
        }
      });

      applyLeadImageState();

      // Static builds bake build-day puzzles/dates; refresh to America/Chicago today.
      void applyEditionDate({
        force: true,
        onApplied: () => schedulePaginate(),
      });

      void applyWeather(settings.zip);
      applyPaperIdentity(settings.paperName, settings.paperTagline);
      applyComicVisibility(settings);
      lastRss = {
        news: bootstrap.news || [],
        businessTech: bootstrap.businessTech || [],
        sports: bootstrap.sports || [],
        lead: bootstrap.lead ? [bootstrap.lead] : [],
        alsoToday: bootstrap.alsoToday || [],
      };
      const urlParams = new URLSearchParams(window.location.search);
      const isSampleParam = urlParams.has('sample');

      if (isSampleParam) {
        void loadSampleBrief();
      } else {
        const storedGrok = loadGrokBrief();
        if (storedGrok?.text) {
          const parsed = parseGrokBrief(storedGrok.text);
          if (parsed.structured) {
            lastGrok = parsed;
            composeEdition(lastRss, lastGrok);
          } else {
            lastGrok = null;
            composeEdition(lastRss, null);
            const ta = document.getElementById('grok-brief-input') as HTMLTextAreaElement | null;
            if (ta) ta.value = storedGrok.text;
          }
        } else {
          composeEdition(lastRss, null);
        }
      }

      if (settings.rssEnabled || (Array.isArray(settings.customFeeds) && settings.customFeeds.length > 0)) {
        void refreshStories(settings);
      }
      if (settings.calendars.length) refreshAgenda(settings);

      // --- Visteras UX & Tool Controller ---
      populateSettingsForm(settings);

      function selectTool(toolName: string) {
        const toolButtons = document.querySelectorAll<HTMLElement>('#tools_left .tool_btn');
        const panels = document.querySelectorAll<HTMLElement>('#sidepanels .sidepanel_pane');
        const statusActive = document.getElementById('status_active_tool');

        toolButtons.forEach((btn) => {
          btn.classList.toggle('active', btn.getAttribute('data-tool') === toolName);
        });

        panels.forEach((p) => {
          p.classList.toggle('active', p.getAttribute('data-panel') === toolName);
        });

        const labels: Record<string, string> = {
          paste: 'Paste Brief',
          typography: 'Typography',
          settings: 'Edition Settings',
          rss: 'RSS Feeds',
        };
        if (statusActive) {
          statusActive.textContent = `Tool: ${labels[toolName] || toolName}`;
        }
      }

      // Toolbar Buttons Click
      document.querySelectorAll<HTMLElement>('#tools_left .tool_btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const tool = btn.getAttribute('data-tool');
          if (tool) selectTool(tool);
        });
      });

      // Accordion Collapsible Sections
      document.querySelectorAll<HTMLElement>('.panel_section_header').forEach((hdr) => {
        hdr.addEventListener('click', () => {
          const section = hdr.closest<HTMLElement>('.panel_section');
          if (section) {
            section.classList.toggle('collapsed');
            const arrow = hdr.querySelector('.panel_section_arrow');
            if (arrow) {
              arrow.textContent = section.classList.contains('collapsed') ? '▶' : '▼';
            }
          }
        });
      });

      // Menu Bar Dropdowns
      const menuEntries = document.querySelectorAll<HTMLElement>('#visteras_menu_bar .menu_entry');
      menuEntries.forEach((entry) => {
        const title = entry.querySelector<HTMLElement>('.menu_entry_title');
        title?.addEventListener('click', (e) => {
          e.stopPropagation();
          const isActive = entry.classList.contains('active');
          menuEntries.forEach((e2) => e2.classList.remove('active'));
          if (!isActive) entry.classList.add('active');
        });
      });
      document.addEventListener('click', () => {
        menuEntries.forEach((e) => e.classList.remove('active'));
      });

      // Menu Dropdown Actions
      document.getElementById('action_new_edition')?.addEventListener('click', () => {
        const ta = document.getElementById('grok-brief-input') as HTMLTextAreaElement | null;
        if (ta) ta.value = '';
        clearGrokBrief();
        lastGrok = null;
        composeEdition(lastRss, null);
        selectTool('paste');
      });

      document.getElementById('action_load_sample')?.addEventListener('click', () => {
        void loadSampleBrief();
        selectTool('paste');
      });

      document.getElementById('action_print')?.addEventListener('click', () => {
        void triggerPrint();
      });

      document.getElementById('action_page_1')?.addEventListener('click', () => showPage(1));
      document.getElementById('action_page_2')?.addEventListener('click', () => showPage(2));
      document.getElementById('action_page_3')?.addEventListener('click', () => showPage(3));

      document.getElementById('action_paste_brief')?.addEventListener('click', () => {
        selectTool('paste');
      });

      document.getElementById('action_clear_brief')?.addEventListener('click', () => {
        const ta = document.getElementById('grok-brief-input') as HTMLTextAreaElement | null;
        if (ta) ta.value = '';
        applyGrokText('');
      });

      document.getElementById('action_open_settings')?.addEventListener('click', () => {
        selectTool('settings');
      });

      document.getElementById('action_tool_paste')?.addEventListener('click', () => {
        selectTool('paste');
      });

      document.getElementById('action_tool_typography')?.addEventListener('click', () => {
        selectTool('typography');
      });

      document.getElementById('action_tool_settings')?.addEventListener('click', () => {
        selectTool('settings');
      });

      document.getElementById('action_tool_rss')?.addEventListener('click', () => {
        selectTool('rss');
      });

      document.getElementById('action_refresh_rss')?.addEventListener('click', () => {
        void refreshStories(settings);
      });

      document.getElementById('action_refresh_weather')?.addEventListener('click', () => {
        void applyWeather(settings.zip);
      });

      document.getElementById('action_repaginate')?.addEventListener('click', () => {
        void runPaginate();
      });

      // Live Typography Inspector
      const typoNameInput = document.getElementById('settings-paper-name') as HTMLInputElement | null;
      const typoTaglineInput = document.getElementById('settings-paper-tagline') as HTMLInputElement | null;
      typoNameInput?.addEventListener('input', () => {
        settings.paperName = typoNameInput.value;
        saveSettings(settings);
        applyPaperIdentity(settings.paperName, settings.paperTagline);
      });
      typoTaglineInput?.addEventListener('input', () => {
        settings.paperTagline = typoTaglineInput.value;
        saveSettings(settings);
        applyPaperIdentity(settings.paperName, settings.paperTagline);
      });

      const typoSizeSelect = document.getElementById('typo-body-size') as HTMLSelectElement | null;
      typoSizeSelect?.addEventListener('change', () => {
        document.documentElement.style.setProperty('--newspaper-body-size', typoSizeSelect.value);
        schedulePaginate();
      });

      const typoLineHeightSelect = document.getElementById('typo-line-height') as HTMLSelectElement | null;
      typoLineHeightSelect?.addEventListener('change', () => {
        document.documentElement.style.setProperty('--newspaper-line-height', typoLineHeightSelect.value);
        schedulePaginate();
      });

      // Global Keyboard Shortcuts
      document.addEventListener('keydown', (e) => {
        const activeEl = document.activeElement;
        const isInput = activeEl && (activeEl.tagName === 'INPUT' || activeEl.tagName === 'TEXTAREA' || (activeEl as HTMLElement).isContentEditable);
        if (isInput) return;

        if (e.key === 'p' || e.key === 'P') {
          if (!e.metaKey && !e.ctrlKey) {
            e.preventDefault();
            selectTool('paste');
          }
        } else if (e.key === 't' || e.key === 'T') {
          if (!e.metaKey && !e.ctrlKey) {
            e.preventDefault();
            selectTool('typography');
          }
        } else if (e.key === 's' || e.key === 'S') {
          if (!e.metaKey && !e.ctrlKey) {
            e.preventDefault();
            selectTool('settings');
          }
        } else if (e.key === 'r' || e.key === 'R') {
          if (!e.metaKey && !e.ctrlKey) {
            e.preventDefault();
            selectTool('rss');
          }
        }
      });
    
      </script>
  </body>
</html>
