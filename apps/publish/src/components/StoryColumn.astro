---
import type { RssStory } from '../data/types';
interface Props {
  label: string;
  stories: RssStory[];
}
const { label, stories } = Astro.props;
---
<section class="story-column" aria-label={label}>
  <h2 class="section-label">{label}</h2>
  {stories.map((s) => (
    <article class="story-item">
      <h3>
        <a href={s.url} target="_blank" rel="noopener noreferrer">{s.title}</a>
      </h3>
      {s.blocks && s.blocks.length ? (
        s.blocks.map((b) => (
          b.type === 'image' && b.src ? (
            <div class="column-image-wrap" data-column-image-wrap data-zoom-step="0">
              <img class="story-image" src={b.src} alt="" loading="lazy" decoding="async" />
              <button type="button" class="column-image-zoom-btn" data-column-image-zoom title="Magnify image (+10%)" aria-label="Magnify image">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="7"></circle>
                  <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
                  <line x1="11" y1="8" x2="11" y2="14"></line>
                  <line x1="8" y1="11" x2="14" y2="11"></line>
                </svg>
              </button>
            </div>
          ) : (
            <p class="deck">{b.text}</p>
          )
        ))
      ) : (
        <>
          {s.image && (
            <div class="column-image-wrap" data-column-image-wrap data-zoom-step="0">
              <img class="story-image" src={s.image} alt="" loading="lazy" decoding="async" />
              <button type="button" class="column-image-zoom-btn" data-column-image-zoom title="Magnify image (+10%)" aria-label="Magnify image">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="7"></circle>
                  <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
                  <line x1="11" y1="8" x2="11" y2="14"></line>
                  <line x1="8" y1="11" x2="14" y2="11"></line>
                </svg>
              </button>
            </div>
          )}
          {s.paragraphs && s.paragraphs.length ? (
            s.paragraphs.map((p) => <p class="deck">{p}</p>)
          ) : (
            <p class="deck">{s.description}</p>
          )}
        </>
      )}
      <div class="meta">{s.source} · link-out</div>
    </article>
  ))}
</section>
