{
  "name": "visteras",
  "version": "1.0.0",
  "private": true,
  "description": "Visteras monorepo \u2014 Studio (raster) + Vector (SVG-Edit companion) + Publish (morning newspaper) + Collage (printable fodder generator).",
  "license": "MIT",
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:hygiene": "node --test scripts/build-site-hygiene.test.mjs",
    "test:vector": "node --test apps/vector/tests/*.test.mjs",
    "test:studio": "node --test apps/studio/tests/*.test.cjs",
    "test:ui": "node --test packages/ui/tests/*.test.mjs && node packages/ui/scripts/build-static.mjs --check && node packages/icons/scripts/copy-tools.mjs --check",
    "check:storage": "node --test scripts/check-no-doc-localstorage.test.mjs && node scripts/check-no-doc-localstorage.mjs",
    "dev:studio": "npm run server --prefix apps/studio",
    "build:studio": "npm run build --prefix apps/studio",
    "dev:vector": "npx --yes serve apps/vector -p 5173",
    "build:vector": "node -e \"console.log('Vector is a static SVG-Edit build under apps/vector; nothing to compile.')\"",
    "dev:publish": "npm run dev --prefix apps/publish",
    "build:publish": "npm run build --prefix apps/publish",
    "dev:collage": "npx --yes serve apps/collage -p 5174",
    "build:collage": "node -e \"console.log('Collage is a static app under apps/collage; nothing to compile.')\"",
    "dev:inspire": "npx --yes serve apps/inspire -p 5175",
    "build:inspire": "node -e \"console.log('Inspire is a static app under apps/inspire; nothing to compile.')\"",
    "test:inspire": "node --test apps/inspire/tests/inspire.test.mjs apps/inspire/tests/presentation.test.mjs apps/inspire/tests/unsaved-changes.test.mjs apps/inspire/tests/grid-config.test.mjs apps/inspire/tests/review-bugs.test.mjs",
    "test:collage": "node --test apps/collage/tests/*.test.mjs",
    "build:site": "bash scripts/build-site.sh",
    "build:fonts": "npm run build:vector --prefix packages/fonts",
    "build:ui": "node packages/ui/scripts/build-static.mjs",
    "build:icons": "node packages/icons/scripts/copy-tools.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mjmacfadden/visteras"
  },
  "homepage": "https://github.com/mjmacfadden/visteras"
}
